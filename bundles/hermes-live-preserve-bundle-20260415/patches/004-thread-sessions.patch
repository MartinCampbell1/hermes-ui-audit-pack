+    def list_threads_rich(
+        self,
+        source: str = None,
+        exclude_sources: List[str] = None,
+        limit: int = 20,
+        offset: int = 0,
+    ) -> List[Dict[str, Any]]:
+        """List user-visible conversation threads.
+
+        A thread groups root sessions with user-visible continuations
+        (compression/branch leaves) and returns the latest visible leaf per
+        thread as the canonical session for UI/display purposes.
+        """
+        where_clauses = ["COALESCE(s.is_user_visible, 1) = 1"]
+        params: list[Any] = []
+        if source:
+            where_clauses.append("s.source = ?")
+            params.append(source)
+        if exclude_sources:
+            placeholders = ",".join("?" for _ in exclude_sources)
+            where_clauses.append(f"s.source NOT IN ({placeholders})")
+            params.extend(exclude_sources)
+
+        query = f"""
+            SELECT s.*,
+                COALESCE(s.thread_id, s.id) AS resolved_thread_id,
+                COALESCE(
+                    (SELECT SUBSTR(REPLACE(REPLACE(m.content, X'0A', ' '), X'0D', ' '), 1, 63)
+                     FROM messages m
+                     WHERE m.session_id = s.id AND m.role = 'user' AND m.content IS NOT NULL
+                     ORDER BY m.timestamp, m.id LIMIT 1),
+                    ''
+                ) AS _preview_raw,
+                COALESCE(
+                    (SELECT MAX(m2.timestamp) FROM messages m2 WHERE m2.session_id = s.id),
+                    s.started_at
+                ) AS last_active
+            FROM sessions s
+            WHERE {" AND ".join(where_clauses)}
+            ORDER BY last_active DESC, s.started_at DESC
+        """
+        with self._lock:
+            cursor = self._conn.execute(query, params)
+            rows = [dict(row) for row in cursor.fetchall()]
+
+        grouped: Dict[str, Dict[str, Any]] = {}
+        for row in rows:
+            thread_key = str(row.get("resolved_thread_id") or row.get("id") or "")
+            if not thread_key or thread_key in grouped:
+                continue
+            raw = str(row.pop("_preview_raw", "") or "").strip()
+            row["preview"] = raw[:60] + ("..." if len(raw) > 60 else "") if raw else ""
+            row["thread_id"] = thread_key
+            row["root_session_id"] = thread_key
+            grouped[thread_key] = row
+
+        threads = list(grouped.values())
+        threads.sort(
+            key=lambda item: (
+                float(item.get("last_active") or item.get("started_at") or 0),
+                float(item.get("started_at") or 0),
+            ),
+            reverse=True,
+        )
+        return threads[offset: offset + limit]
+
+    def export_real_sessions(
+        self,
+        source: str = None,
+        exclude_sources: List[str] = None,
+    ) -> List[Dict[str, Any]]:
+        """Export canonical user-visible threads for external UI consumers."""
+        threads = self.list_threads_rich(
+            source=source,
+            exclude_sources=exclude_sources,
+            limit=100000,
+            offset=0,
+        )
+        results: List[Dict[str, Any]] = []
+        for thread in threads:
+            canonical_session_id = str(thread.get("id") or "")
+            if not canonical_session_id:
+                continue
+            messages = self.get_messages(canonical_session_id)
+            results.append({**thread, "messages": messages})
+        return results
+
