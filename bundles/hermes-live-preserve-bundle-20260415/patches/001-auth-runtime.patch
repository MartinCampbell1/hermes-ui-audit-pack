+def _run_codex_browser_oauth_flow(*, open_browser: bool = True) -> Dict[str, str]:
+    state = secrets.token_urlsafe(32)
+    code_verifier, code_challenge = _generate_codex_pkce_pair()
+
+    last_error: Optional[Exception] = None
+    server: Optional[_CodexOAuthCallbackServer] = None
+    for port in (CODEX_OAUTH_PREFERRED_PORT, 0):
+        try:
+            server = _CodexOAuthCallbackServer(
+                ("127.0.0.1", port),
+                _CodexOAuthCallbackHandler,
+                expected_state=state,
+            )
+            break
+        except OSError as exc:
+            last_error = exc
+    if server is None:
+        raise AuthError(
+            f"Unable to start Codex localhost callback server: {last_error}",
+            provider="openai-codex",
+            code="codex_browser_callback_bind_failed",
+        )
+
+    redirect_uri = f"http://localhost:{server.server_port}{CODEX_OAUTH_CALLBACK_PATH}"
+    verification_url = _build_codex_browser_login_url(
+        redirect_uri=redirect_uri,
+        state=state,
+        code_challenge=code_challenge,
+    )
+
+    print("To continue, open this link in your browser:\n")
+    print(f"  \033[94m{verification_url}\033[0m\n")
+    print(f"Waiting for browser login callback on {redirect_uri} ... (press Ctrl+C to cancel)")
+
+    thread = threading.Thread(target=server.serve_forever, daemon=True)
+    thread.start()
+    try:
+        if open_browser:
+            opened = webbrowser.open(verification_url)
+            if opened:
+                print("Opened browser automatically.")
+            else:
+                print("Could not open browser automatically — use the full link above.")
+
+        finished = server.finished.wait(timeout=CODEX_OAUTH_BROWSER_TIMEOUT_SECONDS)
+        if not finished:
+            raise AuthError(
+                "Login timed out waiting for browser authorization callback.",
+                provider="openai-codex",
+                code="codex_browser_login_timeout",
+            )
+    except KeyboardInterrupt:
+        print("\nLogin cancelled.")
+        raise SystemExit(130)
+    finally:
+        try:
+            server.shutdown()
+        except Exception:
+            pass
+        server.server_close()
+        thread.join(timeout=1.0)
+
+    if server.auth_error:
+        detail = server.auth_error_description or server.auth_error
+        raise AuthError(
+            f"Browser login failed: {detail}",
+            provider="openai-codex",
+            code=str(server.auth_error),
+        )
+    if not server.authorization_code:
+        raise AuthError(
+            "Browser login did not return an authorization code.",
+            provider="openai-codex",
+            code="codex_browser_missing_authorization_code",
+        )
+
+    return {
+        "authorization_code": server.authorization_code,
+        "code_verifier": code_verifier,
+        "redirect_uri": redirect_uri,
+        "verification_url": verification_url,
+        "source": "browser-oauth",
+    }
