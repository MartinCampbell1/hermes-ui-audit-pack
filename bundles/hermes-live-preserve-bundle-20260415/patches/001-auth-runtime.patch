+class _CodexOAuthCallbackServer(http.server.ThreadingHTTPServer):
+    allow_reuse_address = True
+    daemon_threads = True
+
+    def __init__(self, server_address, request_handler_class, *, expected_state: str):
+        super().__init__(server_address, request_handler_class)
+        self.expected_state = expected_state
+        self.authorization_code: Optional[str] = None
+        self.auth_error: Optional[str] = None
+        self.auth_error_description: Optional[str] = None
+        self.finished = threading.Event()
+
+
+class _CodexOAuthCallbackHandler(http.server.BaseHTTPRequestHandler):
+    server: _CodexOAuthCallbackServer
+
+    def log_message(self, format: str, *args) -> None:  # pragma: no cover
+        return
+
+    def _finish_and_shutdown(self) -> None:
+        self.server.finished.set()
+        threading.Thread(target=self.server.shutdown, daemon=True).start()
+
+    def _send_html(self, html: str, *, status: int = 200) -> None:
+        payload = html.encode("utf-8")
+        self.send_response(status)
+        self.send_header("Content-Type", "text/html; charset=utf-8")
+        self.send_header("Content-Length", str(len(payload)))
+        self.end_headers()
+        self.wfile.write(payload)
+        try:
+            self.wfile.flush()
+        except Exception:
+            pass
+
+    def do_GET(self) -> None:
+        parsed = urllib.parse.urlparse(self.path)
+        if parsed.path != CODEX_OAUTH_CALLBACK_PATH:
+            self._send_html("<html><body><h1>Not found</h1></body></html>", status=404)
+            self._finish_and_shutdown()
+            return
+
+        params = urllib.parse.parse_qs(parsed.query)
+        error = str((params.get("error") or [""])[0] or "").strip()
+        if error:
+            self.server.auth_error = error
+            self.server.auth_error_description = str((params.get("error_description") or [""])[0] or "").strip()
+            self._send_html(
+                "<html><body><h1>Login failed</h1><p>You can close this window and return to Hermes.</p></body></html>",
+                status=400,
+            )
+            self._finish_and_shutdown()
+            return
+
+        state = str((params.get("state") or [""])[0] or "").strip()
+        code = str((params.get("code") or [""])[0] or "").strip()
+        if not code:
+            self.server.auth_error = "missing_code"
+            self.server.auth_error_description = "Login callback did not include an authorization code."
+            self._send_html(
+                "<html><body><h1>Login failed</h1><p>Missing authorization code. You can close this window.</p></body></html>",
+                status=400,
+            )
+            self._finish_and_shutdown()
+            return
+        if state != self.server.expected_state:
+            self.server.auth_error = "invalid_state"
+            self.server.auth_error_description = "Login callback state did not match the request."
+            self._send_html(
+                "<html><body><h1>Login failed</h1><p>State mismatch. You can close this window.</p></body></html>",
+                status=400,
+            )
+            self._finish_and_shutdown()
+            return
+
+        self.server.authorization_code = code
+        self._send_html(
+            "<html><body><h1>Login successful</h1><p>You can close this window and return to Hermes.</p></body></html>",
+        )
+        self._finish_and_shutdown()
+
