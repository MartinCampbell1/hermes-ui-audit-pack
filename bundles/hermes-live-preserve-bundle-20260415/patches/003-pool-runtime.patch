+def _coerce_codex_stream_value(value: Any) -> Any:
+    """Convert dict-backed Codex stream payloads into attribute-access objects."""
+    if isinstance(value, dict):
+        return SimpleNamespace(
+            **{k: _coerce_codex_stream_value(v) for k, v in value.items()}
+        )
+    if isinstance(value, list):
+        return [_coerce_codex_stream_value(v) for v in value]
+    return value
+
+
+def _rehydrate_codex_stream_response(
+    response: Any,
+    output_items: list[Any],
+    text_chunks: list[str],
+) -> Any:
+    """Patch SDK responses whose final output is empty despite valid stream items."""
+    existing_output = getattr(response, "output", None) if response is not None else None
+    if isinstance(existing_output, list) and existing_output:
+        return response
+
+    hydrated_items = [
+        _coerce_codex_stream_value(item) for item in output_items if item is not None
+    ]
+
+    if not hydrated_items:
+        final_text = "".join(chunk for chunk in text_chunks if isinstance(chunk, str))
+        if final_text:
+            hydrated_items = [
+                SimpleNamespace(
+                    type="message",
+                    role="assistant",
+                    status="completed",
+                    content=[SimpleNamespace(type="output_text", text=final_text)],
+                )
+            ]
+
+    if not hydrated_items:
+        return response
+
+    final_text = "".join(chunk for chunk in text_chunks if isinstance(chunk, str))
+
+    if response is None:
+        payload: Dict[str, Any] = {"output": hydrated_items}
+        if final_text:
+            payload["output_text"] = final_text
+        return SimpleNamespace(**payload)
+
+    try:
+        setattr(response, "output", hydrated_items)
+        if final_text and not getattr(response, "output_text", None):
+            setattr(response, "output_text", final_text)
+        return response
+    except Exception:
+        payload: Dict[str, Any] = {}
+        if hasattr(response, "model_dump"):
+            try:
+                payload = response.model_dump()
+            except Exception:
+                payload = {}
+        if not payload and hasattr(response, "__dict__"):
+            payload = dict(response.__dict__)
+        payload["output"] = hydrated_items
+        if final_text and not payload.get("output_text"):
+            payload["output_text"] = final_text
+        return SimpleNamespace(**payload)
+
+
+def _flatten_codex_reasoning_summary(summary: Any) -> list[str]:
+    """Normalize Responses reasoning summary payloads into plain strings."""
+    parts: list[str] = []
+    if isinstance(summary, str):
+        text = summary.strip()
+        if text:
+            parts.append(text)
+        return parts
+    if isinstance(summary, list):
+        for item in summary:
+            if isinstance(item, str):
+                text = item.strip()
+                if text:
+                    parts.append(text)
+                continue
+            if isinstance(item, dict):
+                candidate = item.get("text") or item.get("summary") or item.get("content")
+            else:
+                candidate = (
+                    getattr(item, "text", None)
+                    or getattr(item, "summary", None)
+                    or getattr(item, "content", None)
+                )
+            if isinstance(candidate, str):
+                text = candidate.strip()
+                if text:
+                    parts.append(text)
+        return parts
+    candidate = (
+        getattr(summary, "text", None)
+        or getattr(summary, "summary", None)
+        or getattr(summary, "content", None)
+    )
+    if isinstance(candidate, str):
+        text = candidate.strip()
+        if text:
+            parts.append(text)
+    return parts
