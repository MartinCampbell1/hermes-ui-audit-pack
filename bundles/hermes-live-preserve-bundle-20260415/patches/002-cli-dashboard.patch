+def _background_process_notification_mode() -> str:
+    """Return the configured CLI background notification mode.
+
+    Reuse the same value shape as gateway mode so users only have one knob:
+    off | result | error | all.
+    """
+    try:
+        raw = CLI_CONFIG.get("display", {}).get("background_process_notifications", "all")
+    except Exception:
+        raw = "all"
+    mode = str(raw or "all").strip().lower()
+    if mode not in {"off", "result", "error", "all"}:
+        return "all"
+    return mode
+
+
+def _should_surface_process_notification(evt: dict) -> bool:
+    """Decide whether a background-process event should be shown in the CLI."""
+    mode = _background_process_notification_mode()
+    if mode == "off":
+        return False
+    evt_type = str(evt.get("type", "completion") or "completion")
+    if evt_type == "watch_disabled":
+        return mode == "all"
+    if evt_type == "watch_match":
+        return mode == "all"
+    if mode == "error":
+        try:
+            return int(evt.get("exit_code", 0) or 0) != 0
+        except Exception:
+            return True
+    return True
+
+
+def _make_passive_process_notification(evt: dict) -> "dict | None":
+    """Wrap a process event as a passive CLI notification.
+
+    Important: this must NOT be routed back into chat() as normal user input.
+    """
+    if not _should_surface_process_notification(evt):
+        return None
+    text = _format_process_notification(evt)
+    if not text:
+        return None
+    return {"kind": "passive_process_notification", "text": text}
+
+
+def _enqueue_passive_process_notification(target_queue: "queue.Queue", evt: dict) -> bool:
+    """Queue a process event as a passive CLI notification.
+
+    Returns True when an event was queued, False when the event was filtered
+    out by the current notification mode.
+    """
+    payload = _make_passive_process_notification(evt)
+    if not payload:
+        return False
+    target_queue.put(payload)
+    return True
+
+
+def _render_passive_process_notification(text: str) -> None:
+    """Display a passive background-process notification in the CLI."""
+    lines = str(text or "").splitlines() or [str(text or "")]
+    print()
+    ChatConsole().print(f"[{_accent_hex()}]{'─' * 40}[/]")
+    for idx, line in enumerate(lines):
+        prefix = "⚙ " if idx == 0 else "  "
+        ChatConsole().print(f"[dim]{_escape(prefix + line)}[/]")
+
