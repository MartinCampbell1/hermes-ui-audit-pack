+        if fatal:
+            print("  Run manually:  cd web && npm install && npm run build")
+        return False
+
+    r2 = subprocess.run([npm, "run", "build"], cwd=web_dir, capture_output=True)
+    if r2.returncode != 0:
+        print(f"  {'✗' if fatal else '⚠'} Web UI build failed" + ("" if fatal else " (dashboard will not be available)"))
+        if fatal:
+            print("  Run manually:  cd web && npm install && npm run build")
+        return False
+
+    print("  ✓ Web UI built")
+    return True
